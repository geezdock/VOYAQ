# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev mode — set to true to bypass Supabase anonymous auth with a local-only session
NEXT_PUBLIC_DEV_AUTH=true

# API keys — get a Gemini key at https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key

# Sentry (optional — leave blank to disable error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx

# Upstash Redis (optional — falls back to in-memory cache if missing)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
